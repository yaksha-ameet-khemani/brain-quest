# Postgres connection string from your database host (e.g. Neon's
# dashboard: Project -> Connection Details -> "Pooled connection"). Keep the
# `?sslmode=require` suffix if your host includes one.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random long strings used to sign session cookies. Generate each with:
# openssl rand -hex 32
KID_SESSION_SECRET=change-me-to-a-long-random-string
PARENT_SESSION_SECRET=change-me-to-a-different-long-random-string

# IANA timezone used to decide when a new "day" starts for the daily-round limit.
APP_TIMEZONE=Asia/Kolkata

# Optional shared secret the GitHub Actions keep-alive workflow sends, so the
# /api/keepalive endpoint isn't wide open to the public internet.
KEEPALIVE_SECRET=change-me-too

# Backups (see docs/SETUP.md's "Automated backups" section). Both of these
# are ONLY needed for the admin "Back up now" button - the daily automatic
# backup runs entirely inside GitHub Actions and reads its own copy of
# BACKUP_ENCRYPTION_KEY from that repo's secrets, not from here.
#
# Same 32-byte key as the GitHub Actions secret of the same name - generate
# ONCE with `openssl rand -base64 32`, save your own copy somewhere safe,
# and never commit it. Encrypts every backup; if it's ever lost, every past
# backup becomes permanently unreadable, so treat it like a house key.
BACKUP_ENCRYPTION_KEY=
# A fine-grained GitHub personal access token scoped to ONLY this repo, with
# "Contents: Read and write" permission and nothing else - lets the admin
# backup button commit a file into this repo's backup/ folder.
GITHUB_BACKUP_TOKEN=
# Optional - defaults to yaksha-ameet-khemani/brain-quest. Only needed if
# this repo is ever forked/renamed.
BACKUP_GITHUB_REPO=
