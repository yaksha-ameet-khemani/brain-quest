# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - SERVER ONLY, never exposed to the browser, never commit this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random long random string used to sign kid login session cookies.
# Generate one with: openssl rand -hex 32
KID_SESSION_SECRET=change-me-to-a-long-random-string

# IANA timezone used to decide when a new "day" starts for the daily round limit.
APP_TIMEZONE=Asia/Kolkata

# Optional shared secret the GitHub Actions keep-alive workflow sends, so the
# /api/keepalive endpoint isn't wide open to the public internet.
KEEPALIVE_SECRET=change-me-too
